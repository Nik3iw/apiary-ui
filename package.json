{
  "name": "@nik3iw/hive-ui",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "Nik3iw",
  "description": "Framework agnostic UI library",
  "keywords": [
    "UI",
    "Component"
  ],
  "homepage": "https://github.com/Nik3iw/hive-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nik3iw/hive-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Nik3iw/hive-ui/issues"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "dev": "vite",
    "type-check": "tsc --project ./tsconfig.build.json --noEmit",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run"
  },
  "dependencies": {
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@nik3iw/eslint-config": "^1.1.0",
    "@nik3iw/prettier-config": "^1.0.1",
    "@nik3iw/tsconfig": "^1.1.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  }
}
