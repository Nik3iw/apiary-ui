{
  "name": "@apiary-ui/core",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "Nik3iw",
  "description": "Framework agnostic UI components",
  "keywords": [
    "UI",
    "Component"
  ],
  "homepage": "https://github.com/Nik3iw/apiary-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nik3iw/apiary-ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Nik3iw/apiary-ui/issues"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts",
      "style": "./dist/apiary-ui.css"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build:components": "tsdown",
    "build:styles": "tailwindcss -i ./src/styles/apiary-ui.css -o ./dist/apiary-ui.css --minify",
    "build": "pnpm run build:components && pnpm run build:styles",
    "lint": "eslint . --report-unused-disable-directives-severity error --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "tailwind-variants": ">=3.0.0"
  },
  "devDependencies": {
    "@nik3iw/eslint-config": "catalog:",
    "@nik3iw/tsconfig": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.11",
    "typescript": "catalog:"
  }
}
